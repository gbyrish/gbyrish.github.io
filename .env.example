# Halpish (AI helper) — server-side configuration.
#
# Copy this file to .env.local and fill in the real values. .env.local is
# gitignored: the API key must never reach the browser or the repo.
#
# On Vercel, set these as Environment Variables in the project settings
# instead of shipping a file.

# Required. BlockRun API key (primary provider).
# Get yours at https://blockrun.ai
BLOCKRUN_API_KEY=

# Model to use on BlockRun.
# Default: nvidia/gpt-oss-120b (supports tool calling and reasoning)
HALPISH_MODEL=nvidia/gpt-oss-120b

# Optional. Groq API key (fallback when BlockRun is unavailable).
# Get yours at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. SambaNova Cloud API key (fallback when Groq is unavailable).
# Only needed if Groq has issues. Leave blank and Halpish will work
# through Groq when it is available.
SAMBANOVA_API_KEY=

# Optional. Anthropic direct API key (secondary fallback when both
# Groq and SambaNova are unavailable).
ANTHROPIC_API_KEY=

# Optional. Overrides the built-in admin allow-list, comma separated.
# Defaults to the same addresses hardcoded in index.html (ADMIN_EMAILS).
HALPISH_ADMIN_EMAILS=

# Optional. Firebase project used for store reads. Defaults match index.html.
FIREBASE_PROJECT_ID=gybrish-store
FIREBASE_API_KEY=AIzaSyAAkIcNkUzzvcbUwXirBxsFPhtZcNqOsV0

# Test hooks (leave blank in production).
# HALPISH_MOCK=true  — uses fake responses, no API calls
# HALPISH_FORCE_ERROR=rate_limit — forces a specific error type for testing
HALPISH_MOCK=
HALPISH_FORCE_ERROR=
