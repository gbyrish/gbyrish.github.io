# Helpish (AI helper) — server-side configuration.
#
# Copy this file to .env.local and fill in the real values. .env.local is
# gitignored: the API key must never reach the browser or the repo.
#
# On Vercel, set these as Environment Variables in the project settings
# instead of shipping a file.

# Required: Ollama Cloud API key.
OLLAMA_API_KEY=

# Model to use on Ollama Cloud.
HELPISH_MODEL=minimax-m3

# Firebase (store reads/writes via REST).
FIREBASE_PROJECT_ID=gybrish-store
FIREBASE_API_KEY=AIzaSyAAkIcNkUzzvcbUwXirBxsFPhtZcNqOsV0

# Optional. Overrides the built-in admin allow-list, comma separated.
HELPISH_ADMIN_EMAILS=

# Test hooks (leave blank in production).
HELPISH_MOCK=
HELPISH_FORCE_ERROR=
