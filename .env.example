# Helpish (AI helper) — server-side configuration.
#
# Copy this file to .env.local and fill in the real values. .env.local is
# gitignored: the API key must never reach the browser or the repo.
#
# On Vercel, set these as Environment Variables in the project settings
# instead of shipping a file.

# Required: Ollama Cloud API key (https://ollama.com/settings/keys).
# On Vercel, set it under Project > Settings > Environment Variables >
# Production, then redeploy. Never commit a real key: this repo is public.
OLLAMA_API_KEY=

# Model to use on Ollama Cloud. Any name from GET https://ollama.com/api/tags.
#
# Paid models - usage credits required on the account, otherwise every call
# answers 402 and Helpish reports code "plan_limit": minimax-m3, minimax-m2.7,
# deepseek-v4*, glm-5*, kimi-*, qwen3.5:397b, mistral-large-3.
#
# Starter models - included on the free plan: gemma4:31b (tools + thinking +
# vision), gpt-oss:120b, gpt-oss:20b, nemotron-3-super, nemotron-3-ultra,
# nemotron-3-nano:30b.
HELPISH_MODEL=minimax-m3

# Health check, no auth and no customer turn needed:
#   GET /api/helpish        (deployed) or /api/helpish/health (dev server)
# returns { ok, provider, model, keyConfigured, code, detail, fix } where code
# is one of ok | no_key | bad_key | plan_limit | model_missing | unreachable.
# 200 when healthy, 503 when not. The key itself is never returned.

# Firebase (store reads/writes via REST).
FIREBASE_PROJECT_ID=gybrish-store
FIREBASE_API_KEY=AIzaSyAAkIcNkUzzvcbUwXirBxsFPhtZcNqOsV0

# Optional. Overrides the built-in admin allow-list, comma separated.
HELPISH_ADMIN_EMAILS=

# Test hooks (leave blank in production).
HELPISH_MOCK=
HELPISH_FORCE_ERROR=
